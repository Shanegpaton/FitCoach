[Unit]
Description=FitCoachGPT unprivileged OAuth browser launcher
After=fitcoach-vnc.service
Requires=fitcoach-vnc.service

[Service]
Type=simple
User=fitcoach-browser
Group=fitcoach-browser
Environment=HOME=/var/lib/fitcoach-browser
Environment=DISPLAY=:1
Environment=XAUTHORITY=/var/lib/fitcoach-browser/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/fitcoach-browser-session
WorkingDirectory=/opt/fitcoach-vm
RuntimeDirectory=fitcoach-browser
RuntimeDirectoryMode=0770
ExecStart=/opt/fitcoach-vm/.venv/bin/python -m prototype.chatgpt_vm.browser_launcher
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
