# Runtime credentials: dedicated non-owner role. Never use postgres here.
FITCOACH_DATABASE_URL=postgresql+psycopg://fitcoach_api:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
# Privileged credentials used only by Alembic, never loaded by the API.
FITCOACH_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
FITCOACH_RUNTIME_ROLE=fitcoach_api
FITCOACH_SUPABASE_URL=https://PROJECT.supabase.co
FITCOACH_SUPABASE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
FITCOACH_CORS_ORIGINS=http://localhost:5173
# Optional ChatGPT VM handoff. Use the same 32-byte base64url secret on the VM.
FITCOACH_CHATGPT_VM_ORIGIN=https://your-vm.example
FITCOACH_CHATGPT_SECRET=GENERATE_A_32_BYTE_BASE64URL_SECRET
# Only disposable local PostgreSQL may omit TLS.
FITCOACH_ALLOW_LOCAL_PLAINTEXT=false
