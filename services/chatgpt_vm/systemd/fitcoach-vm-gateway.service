[Unit]
Description=FitCoachGPT VM ChatGPT sign-in gateway
After=network-online.target fitcoach-browser-launcher.service
Wants=network-online.target
Requires=fitcoach-browser-launcher.service

[Service]
Type=simple
User=fitcoach-auth
Group=fitcoach-auth
SupplementaryGroups=fitcoach-browser
Environment=HOME=/var/lib/fitcoach-auth
EnvironmentFile=/etc/fitcoach-vm.env
WorkingDirectory=/opt/fitcoach-vm
ExecStart=/opt/fitcoach-vm/.venv/bin/python -m services.chatgpt_vm.gateway serve --storage /var/lib/fitcoach-auth/state
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
